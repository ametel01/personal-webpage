{
  "name": "personal-webpage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify": "bun run format && bun run lint && bun run typecheck && bun run test",
    "test:e2e": "playwright test",
    "test:seo": "playwright test tests/e2e/seo-retrieval.e2e.ts --project=chromium-desktop",
    "test:ai-crawlers": "bun run scripts/ai-crawler-smoke.ts",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@fontsource/source-serif-4": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.17.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "simple-icons": "^16.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
